\begin{tikzpicture}[%
  every path/.style = {
   ->,
   > = stealth, 
   rounded corners},
  state/.style = {
    fill = white,
    text centered
  },
  node distance=1.25cm]

  \definecolor{color1}{HTML}{E7AD00}
  \definecolor{color2}{HTML}{A5CC19}
  \definecolor{color3}{HTML}{33B29A}
  \definecolor{color4}{HTML}{3380FF}
  \definecolor{color5}{HTML}{9033FF}
  \definecolor{color6}{HTML}{E5003D}

\begin{scope}[
  opacity = 1,
  fill opacity = 0.25,
  text opacity = 1,
  text width = 6em,
  text centered]

  \def\firstcircle{(90:2.75cm) circle (3.5cm)}
  \def\secondcircle{(210:2.75cm) circle (3.5cm)}
  \def\thirdcircle{(330:2.75cm) circle (3.5cm)}
  \draw [fill = color6] \firstcircle; % Repetição
  \draw [fill = color4] \secondcircle; % Casualização
  \draw [fill = color2] \thirdcircle; % Controle Local

\end{scope}

\begin{scope}[minimum width = 1em, text width = 5.0em, text centered]

  % Princípios isolados
  \node[state] (rep) at (90:5.5) {\emph{Repetição}};
  \node[state] (cas) at (210:5.0) {\emph{Casualização}};
  \node[state] (ctl) at (-30:5.0) {\emph{Controle Local}};

  % Interseções binárias
  \node (repcas) at (90:3) {Sem Controle Local\\Problemas:\\- Influência de variações previsíveis};
  \node (casctl) at (210:3) {Sem Repetição\\Problemas:\\- Alta variabilidade aleatória};
  \node[text width = 7em] (repctl) at (-30:3) {Sem Casualização\\Problemas:\\- Resultados enviesados};

  % Fora da interseção (sem 2 princípios)
  \node[color = red] (nocasctl) at (30:2) {Apenas Repetição:\\Resultados não confiáveis};
  \node[color = red] (norepctl) at (150:2) {Apenas Casualização:\\Alta variabilidade};
  \node[color = red] (norepcas) at (-90:2) {Apenas Controle Local:\\Influência de fatores aleatórios e vieses};

  % Interseção tripla (ideal)
  \node (ideal) at (0:0) {\large Experimento Ideal:\\ Alta precisão e validade};

\end{scope}

\end{tikzpicture}%
